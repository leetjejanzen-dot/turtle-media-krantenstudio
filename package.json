{
  "name": "fivem-krantenstudio",
  "version": "1.1.0",
  "description": "Turtle Media Creator Suite voor Windows",
  "main": "main.js",
  "author": {
    "name": "Turtle Investment"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "electron . --smoke-test",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "nl.fivem.krantenstudio",
    "productName": "Turtle Media",
    "copyright": "Copyright © 2026 Turtle Investment",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/html2canvas/**/*",
      "node_modules/pdf-lib/**/*",
      "node_modules/@pdf-lib/**/*",
      "node_modules/pako/**/*",
      "node_modules/tslib/**/*"
    ],
    "extraResources": [
      {
        "from": "publisher-config.json",
        "to": "publisher-config.json"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "src/assets/turtle-media.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "artifactName": "Turtle-Media-Krantenstudio-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
